{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "ignore": ["node_modules", "data-out", "scripts", "*.test.js", ".git"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": { "port": 8080 },
